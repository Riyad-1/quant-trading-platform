APP_NAME=Quant Trading Platform
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

DATABASE_URL=postgresql://quantuser:quantpassword@localhost:5432/quantdb
REDIS_URL=redis://localhost:6379/0

SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

ALPHA_VANTAGE_API_KEY=
POLYGON_API_KEY=
ALPACA_API_KEY=
FRED_API_KEY=
